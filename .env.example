# AI backend for reading-level explanations and "Ask about this verse".
# All other features work without this. Copy to `.env` and fill in as needed.
# See the README for accepted request/response shapes.

# URL to POST completions to (a proxy you host, or Anthropic's Messages API).
VITE_AI_ENDPOINT=

# Optional API key / bearer token.
# WARNING: a key set here is bundled into the client and visible to anyone.
# Prefer a server-side proxy for public deployments.
VITE_AI_API_KEY=

# Optional model id (e.g. an Anthropic model name for direct calls).
VITE_AI_MODEL=
