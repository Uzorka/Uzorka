# AI backend for the reading-level explanations and "Ask about this verse".
# All other features work without this. See the README for details.
#
# The bundled serverless proxy (api/complete.js) supports three providers.
# Set these in your Vercel project's Environment Variables (Server, not exposed
# to the browser). Pick ONE provider and provide its key.

# Which provider the proxy uses: anthropic (default) | openai | gemini
AI_PROVIDER=gemini

# --- Google Gemini (has a free tier — get a key at aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=            # default gemini-1.5-flash-latest

# --- Anthropic (console.anthropic.com — prepaid) --------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=         # default claude-opus-4-8

# --- OpenAI (platform.openai.com — prepaid) -------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=            # default gpt-4o-mini

# --- Advanced: point the client at a fully custom endpoint ----------------
# VITE_* vars are bundled into the client and are PUBLIC — prefer the proxy.
VITE_AI_PROVIDER=        # anthropic | openai | gemini (for VITE_AI_API_KEY)
VITE_AI_ENDPOINT=
VITE_AI_API_KEY=
VITE_AI_MODEL=
