{
  "name": "oneestore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ONEESTORE — fresh seafood, ordered simply. A glass-surfaced, motion-led storefront for Lagos seafood delivery.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "review:responsive": "node tools/responsive.mjs",
    "review:contrast": "node tools/contrast.mjs",
    "review:glass": "node tools/glass.mjs",
    "review:flow": "node tools/flow.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
